Screen {
    background: $background;
    color: $foreground;
}

#app-layout {
    height: 1fr;
}

.panel {
    border: heavy $primary;
    background: $background;
    padding: 0 1;
    margin: 0 1;
}

#left-panel {
    width: 18%;
    # min-width: 28;
    layout: vertical;
}

#center-panel {
    width: 1fr;
    # min-width: 70;
}

#right-panel {
    width: 20%;
    # min-width: 30;
}

.section-title {
    color: $secondary;
    text-style: bold;
}

#connection-tabs{
    height: 1fr;
    margin-top: 1;
    # padding: 0 1;
}

#left-panel-actions {
    dock: bottom;
    height: auto;
    margin-top: 1;
}

#workspace-tabs {
    height: 1fr;
    min-height: 1;
}

#device-list {
    width: 1fr;
    margin-bottom: 1;
}

TabPane {
    padding: 0;
}

#workspace-toolbar {
    layout: horizontal;
    height: auto;
    margin-top: 0;
    margin-bottom: 1;
}

.workspace-toolbar-widget {
    height: auto;
    border: round $secondary;
    padding: 0 0;
    margin-right: 1;
}

#workspace-connection-widget {
    width: auto;
    min-width: 0;
}

#workspace-connection-row {
    height: auto;
    width: auto;
}

#connection-status-label {
    color: $secondary;
    text-style: bold;
}

#connection-status-label {
    width: auto;
    margin-right: 0;
}

#connection-status-led {
    width: 3;
    min-width: 3;
    height: 1;
    background: $surface;
    border: round $panel;
}

#connection-status-led.connected {
    background: $success;
    border: round $success;
}

#workspace-data-widget {
    width: 1fr;
    min-width: 10;
}

.workspace-data-row {
    height: auto;
    width: 1fr;
}

.workspace-data-label {
    width: 2;
    color: $accent;
}

.workspace-data-label-rx {
    color: $success;
}

.workspace-data-label-tx {
    color: $error;
}

#workspace-data-widget Sparkline {
    width: 1fr;
}

#workspace-rx-sparkline > .sparkline--max-color {
    color: $success;
}

#workspace-rx-sparkline > .sparkline--min-color {
    color: $success 30%;
}

#workspace-tx-sparkline > .sparkline--max-color {
    color: $error;
}

#workspace-tx-sparkline > .sparkline--min-color {
    color: $error 30%;
}

#workspace-toolbar-actions {
    width: 14;
    height: auto;
}

#clear-console-btn,
#close-active-workspace {
    width: 1fr;
    margin-top: 0;
    margin-left: 0;
    height: 1;
}

#clear-console-btn {
    margin-bottom: 0;
}

#tx-row {
    layout: horizontal;
    height: auto;
}

.stack-row,
#config-editor-toolbar {
    height: auto;
}

#left-panel-actions Button {
    width: 1fr;
}

#workspace-status {
    width: 1fr;
    height: auto;
    border: round $accent;
    margin-top: 0;
    padding: 0 1;
}

#workspace-selection,
#current-user-summary {
    width: 1fr;
    height: auto;
}

#workspace-selection {
    margin-bottom: 0;
}

#current-user-summary {
    margin-top: 0;
    margin-bottom: 0;
}

#function-buttons-row {
    layout: horizontal;
    height: auto;
}

#command-config-select {
    # margin-bottom: 1;
    margin-top: 1;
}

#command-buttons-scroll {
    height: 1fr;
    border: solid $secondary;
    background: $background;
    # padding: 0 1;
}

#timestamp-checkbox {
    width: auto;
    margin-right: 1;
    margin-top: 0;
}

.workspace-pane {
    height: 1fr;
    min-height: 1;
}

.workspace-content,
.workspace-pane RichLog {
    border: solid $secondary;
    height: 1fr;
    min-height: 1;
    padding: 0 1;
    background: $background;
}

#workspace-placeholder {
    # content-align: right bottom;
    content-align: center middle;
}

#logo {
        
}

.workspace-placeholder-text {
    color: $accent;
    margin-bottom: 0;
}

#tx-input {
    width: 1fr;
    margin-right: 1;
    margin-top: 0;
}

#tx-terminate-option {
    width: 18;
    margin-right: 1;
    margin-top: 0;
}

#send-btn {
    width: auto;
    margin-top: 0;
}

#tx-hex-checkbox {
    width: auto;
    # margin-right: 1;
    margin-top: 0;
}

#baud-select,
#parity-select,
#stopbits-select,
#databits-select {
    margin-bottom: 1;
}

#auto-log-checkbox {
    margin-bottom: 1;
    # margin-right: 1;
    width: 1fr;
}

#log-filepath {
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 1;
    width: 58%;
}

#toggle-logging {
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 1;
    margin-left: 2;
}

.command-button {
    width: 40%;
    margin-bottom: 1;
    margin-right: 1;
    # margin-left: 1;
}

.command-row {
    layout: horizontal;
    height: auto;
}

.command-group {
    margin-bottom: 1;
    padding-left: 1;
    border-left: heavy $panel;
    border-bottom: heavy $panel;
    height: auto;
}

.command-group-title {
    color: $secondary;
    text-style: bold;
    margin: 1 0;
}

.command-depth-2 {
    # border-left: solid $secondary;
}

.command-depth-3 {
    border-left: solid $accent;
}

.wide-btn {
    width: 1fr;
    margin-bottom: 1;
    color: $secondary;
}

#ip-input {
    margin-bottom: 1;
}

#port-input {
    margin-bottom: 1;
}

#clear-tcp-inputs {
    width: 1fr;
    margin-bottom: 1;
}

.hint {
    color: $accent;
    margin-bottom: 1;
}

#config-file-browser {
    width: 40;
}

#config-browser-actions {
    height: auto;
    margin-bottom: 1;
}

#config-new {
    width: 1fr;
}

#config-file-tree {
    height: 1fr;
    border: solid $secondary;
    background: $background;
}

#config-command-editor {
    width: 1fr;
    padding: 1 1;
}

#config-editor-form {
    height: 1fr;
}

#config-editor-scroll {
    height: 1fr;
}

#config-name-row {
    height: auto;
    margin-bottom: 1;
}

#config-name-input {
    width: 1fr;
}

#config-add-command {
    width: auto;
    margin-left: 1;
}

#config-command-rows {
    height: auto;
    margin-top: 0;
}

.config-command-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.config-input-label {
    width: 10;
    height: 3;
    border: round $secondary;
    color: $secondary;
    content-align: center middle;
}

.config-command-input {
    width: 1fr;
}

.config-command-label-input {
    margin-right: 1;
}

.config-command-value-input {
    margin-right: 1;
}

#config-editor-actions {
    height: auto;
    margin-top: 1;
}

#config-save,
#config-close {
    width: auto;
    margin-right: 1;
}

.config-command-delete {
    width: 5;
    min-width: 5;
    height: 3;
    content-align: center middle;
    text-align: center;
}

#config-file-preview {
    width: 20%;
    padding: 1 1;
}

#config-preview-scroll {
    height: 1fr;
    min-height: 16;
    border: solid $secondary;
    background: $background;
}

#config-editor-preview {
    width: 1fr;
    height: auto;
}

#right-panel-header {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
    # padding: 0 1;
}

#right-panel-spacer {
    width: 1fr;
}

#config-editor-btn {
    width: auto;
    height: auto;
    margin-right: 0;
    margin-left: 1;
}

#footer-row {
    height: 1;
    background: $background;
}

#app-footer {
    width: 1fr;
    background: $background;
    color: $foreground;
}

#footer-brand {
    width: auto;
    min-width: 30;
    content-align: right middle;
    background: $surface;
    color: $accent;
    padding-right: 1;
}
