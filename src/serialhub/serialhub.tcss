Screen {
    background: $background;
    color: $foreground;
}

#app-layout {
    height: 1fr;
}

.panel {
    border: heavy $primary;
    background: $background;
    padding: 1;
    margin: 0 1;
}

#left-panel {
    width: 18%;
    # min-width: 28;
    layout: vertical;
}

#center-panel {
    width: 1fr;
    # min-width: 70;
}

#right-panel {
    width: 20%;
    # min-width: 30;
}

.section-title {
    color: $secondary;
    text-style: bold;
}

#label-row {
    layout: horizontal;
    height: auto;
    width: auto;
}

#connection-tabs{
    height: 1fr;
}

#left-panel-actions {
    dock: bottom;
    height: auto;
    margin-top: 1;
}

#workspace-tabs {
    height: 70%;
    # margin-bottom: 1;
}

#device-list {
    width: 1fr;
    margin-bottom: 1;
}

TabPane {
    padding: 0;
}

#workspace-toolbar {
    layout: horizontal;
    height: 8%;
    # border: solid $accent;
    margin-top: 0;

}

#tx-row {
    layout: horizontal;
    height: auto;
}

.stack-row,
#script-screen-toolbar {
    height: auto;
}

#left-panel-actions Button {
    width: 1fr;
}

#workspace-selection,
#script-active-device {
    width: 1fr;
    height: auto;
}

#function-buttons-row {
    layout: horizontal;
}

#command-config-select {
    # margin-bottom: 1;
    margin-top: 1;
}

#command-buttons-scroll {
    height: 1fr;
    border: solid $secondary;
    background: $background;
    # padding: 0 1;
}

#timestamp-checkbox,
#open-script-editor,
#script-start,
#script-stop {
    width: auto;
    margin-right: 1;
    margin-top: 1;
}

.workspace-pane {
    height: 1fr;
    min-height: 1;
}

#close-active-workspace {
    width: auto;
    # margin-top: 1;
}

.workspace-content,
.workspace-pane RichLog {
    border: solid $secondary;
    height: 1fr;
    min-height: 1;
    padding: 0 1;
    background: $background;
}

#workspace-placeholder {
    # content-align: right bottom;
    content-align: center middle;
}

#logo {
        
}

.workspace-placeholder-text {
    color: $accent;
    margin-bottom: 0;
}

#workspace-tabs {
    height: 70%;
}

#tx-input {
    width: 1fr;
    margin-right: 1;
    margin-top: 1;
}

#tx-terminate-option {
    width: 18;
    margin-right: 1;
    margin-top: 1;
}

#send-btn {
    width: auto;
    margin-top: 1;
}

#tx-hex-checkbox {
    width: auto;
    # margin-right: 1;
    margin-top: 1;
}

#baud-select,
#parity-select,
#stopbits-select,
#databits-select {
    margin-bottom: 1;
}

#auto-log-checkbox {
    margin-bottom: 1;
    margin-right: 1;
    width: 1fr;
}

#log-filepath {
    margin-top: 1;
    margin-bottom: 1;
    margin-right: 1;
    width: 58%;
}

#toggle-logging {
    margin-top: 1;
    margin-bottom: 1;
    margin-right: 1;
}

.command-button {
    width: 40%;
    margin-bottom: 1;
    margin-right: 1;
    # margin-left: 1;
}

.command-row {
    layout: horizontal;
    height: auto;
}

.command-group {
    margin-bottom: 1;
    padding-left: 1;
    border-left: heavy $panel;
    border-bottom: heavy $panel;
    height: auto;
}

.command-group-title {
    color: $secondary;
    text-style: bold;
    margin: 1 0;
}

.command-depth-2 {
    # border-left: solid $secondary;
}

.command-depth-3 {
    border-left: solid $accent;
}

.wide-btn {
    width: 1fr;
    margin-bottom: 1;
    color: $secondary;
}

#ip-input {
    margin-bottom: 1;
}

#port-input {
    margin-bottom: 1;
}

#clear-tcp-inputs {
    width: 1fr;
    margin-bottom: 1;
}

.hint {
    color: $accent;
    margin-bottom: 1;
}

#script-screen {
    # background: $panel;
    # border: heavy $accent;
    padding: 1 1;
}

#script-editor {
    height: 1fr;
    min-height: 12;
    border: solid $secondary;
    background: $background;
}

#current-user-summary {
    width: auto;
    margin-right: 4;
    
}

#config-editor-btn {
    width: auto;
    height: auto;
    margin-right: 1;
    margin-left: 1;

}

#footer-row {
    height: 1;
    background: $background;
}

#app-footer {
    width: 1fr;
    background: $background;
    color: $foreground;
}

#footer-brand {
    width: auto;
    min-width: 30;
    content-align: right middle;
    background: $surface;
    color: $accent;
    padding-right: 1;
}
