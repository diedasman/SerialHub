Screen {
    background: $background;
    color: $foreground;
}

#app-layout {
    height: 1fr;
}

.panel {
    border: heavy $primary;
    border-title-align: center;
    background: $background;
    padding: 0 1;
    margin: 0 1;
}

#left-panel {
    width: 18%;
    # min-width: 28;
    layout: vertical;
}

#center-panel {
    width: 1fr;
    # min-width: 70;
}

#right-panel {
    width: 20%;
    # min-width: 30;
}

.section-title {
    color: $secondary;
    text-style: bold;
}

#settings-modal {
    width: 50%;
}

#connection-tabs{
    height: 1fr;
    margin-top: 1;
    # padding: 0 1;
}

#left-panel-actions {
    dock: bottom;
    height: auto;
    margin-top: 1;
    width: auto;
}

#workspace-tabs {
    height: 1fr;
    min-height: 1;
}

#device-list {
    width: 1fr;
    margin-bottom: 1;
}

TabPane {
    padding: 0;
}

#workspace-toolbar {
    layout: horizontal;
    height: auto;
    margin-top: 0;
    # margin-bottom: 1;
}

.workspace-toolbar-widget {
    height: 5;
    border: round $secondary;
    padding: 0 1;
    margin-right: 1;
}

#workspace-connection-widget {
    width: 16;
    # min-width: 24;
}

#connection-status-row {
    layout: horizontal;
    height: auto;
    width: auto;
    content-align: left middle;
}

#connection-status-title {
    height: auto;
    width: auto;
    color: $secondary;
    text-style: bold;
    margin-right: 1;
}

#connection-status-title.-on {
    color: $success;
}

#connection-status-title.-off {
    color: $panel-lighten-1;
}

#workspace-status-indicators {
    height: 1;
    width: auto;
    content-align: left middle;
    margin-top: 0;
}

.workspace-indicator-label {
    width: auto;
    color: $secondary;
    margin-right: 1;
}

#workspace-rx-label.-on {
    color: $error;
}

#workspace-tx-label.-on {
    color: $success;
}

#workspace-rx-label.-off,
#workspace-tx-label.-off {
    color: $secondary;
}

#connection-status-led,
.workspace-activity {
    width: auto;
    min-width: 1;
    content-align: left middle;
    padding: 0;
    margin-left: 0;
    text-style: bold;
}

#connection-status-rule {
    height: 1;
    margin: 0;
    color: $panel-lighten-1;
}

#connection-status-led,
#workspace-rx-activity {
    margin-right: 4;
}

#connection-status-led.-on {
    color: $success;
}

#connection-status-led.-off,
.workspace-activity.-off {
    color: $panel-lighten-1;
}

#workspace-data-widget {
    width: 1fr;
    height: 5;
}

.workspace-activity {
    height: auto;
    margin-right: 1;
}

#workspace-rx-activity.-on {
    color: $error;
}

#workspace-tx-activity.-on {
    color: $success;
}

.workspace-direction-sparkline {
    width: 1fr;
    height: 1;
}

#workspace-rx-sparkline {
    margin-bottom: 1;
    # margin-top: 1;
}

.workspace-direction-sparkline.-idle > .sparkline--max-color,
.workspace-direction-sparkline.-idle > .sparkline--min-color {
    color: $panel-lighten-1;
}

#workspace-rx-sparkline.-active > .sparkline--max-color,
#workspace-rx-sparkline.-active > .sparkline--min-color {
    color: $error;
}

#workspace-tx-sparkline.-active > .sparkline--max-color,
#workspace-tx-sparkline.-active > .sparkline--min-color {
    color: $success;
}

#workspace-toolbar-buttons {
    layout: horizontal;
    height: auto;
    width: 28;
    # content-align: left top;
    margin-top: 1;
    # padding: 0 1;
}

#clear-console-btn,
#close-active-workspace {
    min-width: 7;
    width: 1fr;
    height: 3;
    padding: 0;
    content-align: center top;
    margin: 0;
}

#tx-row {
    layout: horizontal;
    height: auto;
}

.stack-row {
    height: auto;
}

#left-panel-actions Button {
    width: 1fr;
}

#workspace-status {
    layout: horizontal;
    width: 1fr;
    height: auto;
    border: round $accent;
    margin-top: 0;
    padding: 0 1;
}

#workspace-selection,
#current-user-summary {
    width: 1fr;
    height: auto;
}

#workspace-selection {
    margin-bottom: 0;
}

#current-user-summary {
    margin-top: 0;
    margin-bottom: 0;
}

#function-buttons-row {
    layout: horizontal;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    # width: 2fr;
}

#timestamp-checkbox {
    width: auto;
    margin-right: 1;
    margin-top: 0;
}

#command-config-select {
    # margin-bottom: 1;
    margin-top: 1;
}

#command-buttons-scroll {
    height: 1fr;
    border: solid $secondary;
    background: $background;
    # padding: 0 1;
}

.workspace-pane {
    height: 1fr;
    min-height: 1;
}

.workspace-content,
.workspace-pane RichLog {
    border: solid $secondary;
    height: 1fr;
    min-height: 1;
    padding: 0 1;
    background: $background;
}

#workspace-placeholder {
    # content-align: right bottom;
    content-align: center middle;
}

.workspace-placeholder-text {
    color: $accent;
    margin-bottom: 0;
}

#tx-input {
    width: 1fr;
    margin-right: 1;
    margin-top: 0;
}

#tx-terminate-option {
    width: 18;
    margin-right: 1;
    margin-top: 0;
}

#send-btn {
    width: auto;
    margin-top: 0;
}

#tx-hex-checkbox {
    width: auto;
    # margin-right: 1;
    margin-top: 0;
}

#baud-select,
#parity-select,
#stopbits-select,
#databits-select {
    margin-bottom: 1;
}

#auto-log-checkbox {
    margin-bottom: 1;
    # margin-right: 1;
    width: 1fr;
}

#log-filepath {
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 1;
    width: 1fr;
}

#toggle-logging {
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 1;
    margin-left: 2;
}

#copy-workspace-btn {
    width: auto;
    min-width: 16;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 1;
    margin-left: 1;
}

.command-button {
    width: 40%;
    margin-bottom: 1;
    margin-right: 1;
    # margin-left: 1;
}

.command-row {
    layout: horizontal;
    height: auto;
}

.command-group {
    margin-bottom: 1;
    padding-left: 1;
    border-left: heavy $panel;
    border-bottom: heavy $panel;
    height: auto;
}

.command-group-title {
    color: $secondary;
    text-style: bold;
    margin: 1 0;
}

.command-depth-2 {
    # border-left: solid $secondary;
}

.command-depth-3 {
    border-left: solid $accent;
}

.wide-btn {
    width: 1fr;
    margin-bottom: 1;
    color: $secondary;
}

#ip-input {
    margin-bottom: 1;
}

#port-input {
    margin-bottom: 1;
}

#clear-tcp-inputs {
    width: 1fr;
    margin-bottom: 1;
}

#tcp-favorites-btn {
    width: 1fr;
    margin-bottom: 1;
}

#tcp-favorites-list {
    width: 1fr;
    margin-bottom: 1;
}

.hint {
    color: $accent;
    margin-bottom: 1;
}

#config-file-browser {
    width: 40;
}

#config-browser-actions {
    height: auto;
    margin-bottom: 1;
    margin-top: 1;
}

#config-new {
    width: 1fr;
    # margin-top: 1;
}

#config-delete {
    width: 1fr;
}

#config-file-tree {
    height: 1fr;
    border: solid $secondary;
    background: $background;
}

#config-command-editor {
    width: 1fr;
    padding: 1 1;
}

#config-editor-form {
    height: 1fr;
}

#config-editor-scroll {
    height: 1fr;
    border: round $secondary;
}

#config-name-row {
    height: auto;
    margin-bottom: 1;
}

#config-name-input {
    width: 1fr;
}

#config-add-command {
    width: auto;
    margin-left: 1;
}

#config-command-rows {
    height: auto;
    margin-top: 0;
}

.config-command-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.config-input-label {
    width: 10;
    height: 3;
    border: round $accent;
    color: $accent;
    content-align: center middle;
}

.config-command-input {
    width: 1fr;
}

.config-command-label-input {
    margin-right: 1;
}

.config-command-value-input {
    margin-right: 1;
}

#config-editor-actions {
    height: auto;
    margin-top: 1;
}

#config-save,
#config-close {
    width: auto;
    margin-right: 1;
}

.config-command-delete {
    width: 5;
    min-width: 5;
    height: 3;
    content-align: center middle;
    text-align: center;
}

#config-file-preview {
    width: 20%;
    padding: 1 1;
}

#config-preview-scroll {
    height: 1fr;
    min-height: 16;
    border: solid $secondary;
    background: $background;
    margin-bottom: 0;
}

#config-editor-preview {
    width: 1fr;
    height: auto;
}

#right-panel-header {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
    margin-top: 1;
    width: auto;
    content-align: center middle;
}

#config-editor-btn,
#user-settings-btn {
    width: 1fr;
    height: auto;
    margin-left: 0;
}

#config-editor-btn {
    margin-right: 1;
}

#user-settings-btn {
    margin-right: 0;
}

#footer-row {
    layout: horizontal;
    align: left middle;
    height: 1;
    background: $background;
}

#app-footer {
    width: 1fr;
    background: $background;
    color: $foreground;
}

#app-version {
    width: auto;
    min-width: 0;
    padding: 0 1;
    background: $background;
    color: $accent;
}

#login-footer {
    width: 1fr;
    background: $background;
    color: $foreground;
}
